{
  "name": "cheesecake-labs-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:e2e": "npm run test:e2e:build && playwright test",
    "test:e2e:build": "VITE_FORMSPREE_MINDSHIFT_ID=test-form npm run build -- --outDir dist-e2e-configured && VITE_FORMSPREE_MINDSHIFT_ID= npm run build -- --outDir dist-e2e-missing",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "posthog-js": "^1.379.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
